# XAIVON Environment Configuration Template
# NOTE: Never commit actual secret values or .env files to version control.
# Configure these variables in Vercel Project Settings (Production/Preview) or local .env.local.

# -----------------------------------------------------------------------------
# Upstash Redis (Serverless Sliding Window Rate Limiting)
# -----------------------------------------------------------------------------
# REST endpoint URL from Upstash Redis console
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io

# REST token with write permissions for rate-limiting operations
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# -----------------------------------------------------------------------------
# Resend (Transactional Email & Form Ingestion)
# -----------------------------------------------------------------------------
# API key from resend.com with permissions to send emails via verified domain
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email address (must match verified domain in Resend)
# Example: XAIVON <notifications@xaivon.com>
RESEND_FROM_EMAIL=XAIVON <notifications@xaivon.com>

# Target recipient inbox for business lead notifications and assessments
# Example: leads@xaivon.com or raja@xaivon.com
RESEND_CONTACT_EMAIL_TO=raja@xaivon.com

# -----------------------------------------------------------------------------
# Client-Side Optional Integrations (Vite Prefix: VITE_)
# -----------------------------------------------------------------------------
# Optional external AI Assistant widget URL (must use https:// protocol in production)
# VITE_AI_ASSISTANT_URL=https://assistant.xaivon.com
